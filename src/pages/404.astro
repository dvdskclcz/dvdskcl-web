---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Stránka nenalezena | 404">
  <main class="min-h-screen flex flex-col items-center justify-center px-6 text-center">
    <div class="space-y-6 max-w-md">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-red-100 dark:bg-red-950/50 border border-red-300 dark:border-red-800 text-red-700 dark:text-red-400">
        Status 404
      </div>
      <h1 class="text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white font-mono">
        Routing Error
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">
        Požadovaná adresa v architektuře webu neexistuje nebo byla přesunuta.
      </p>
      <div>
        <a 
          href="/" 
          class="inline-flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-emerald-500 text-slate-950 font-bold px-6 py-3 rounded-xl shadow-lg shadow-cyan-500/20 hover:opacity-95 transition-all text-sm"
        >
          <span>Zpět na úvodní stránku</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>