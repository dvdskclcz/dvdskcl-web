---
import Layout from '../../layouts/Layout.astro';
import ThemeToggle from '../../components/ThemeToggle.astro';
import profile from '../../data/profile.json';
import projects from '../../data/projects.json';
---

<Layout title={`${profile.name} | ${profile.title.en}`} lang="en">
  <!-- Top Navigation -->
  <header class="sticky top-0 z-50 border-b border-slate-200 dark:border-slate-800/80 bg-white/80 dark:bg-slate-950/80 backdrop-blur-md">
    <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-mono font-semibold tracking-tight text-slate-900 dark:text-white">{profile.name}</span>
      </div>
      <nav class="flex items-center gap-4 sm:gap-6 text-sm text-slate-600 dark:text-slate-300">
        <a href="#projects" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors hidden sm:inline">Projects</a>
        <a href="#expertise" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors hidden sm:inline">Expertise</a>
	<a href="#contact" class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors hidden sm:inline">Contact</a>
        
        <!-- Theme Toggle (Dark / Light) -->
        <ThemeToggle />

        <!-- Language Switcher back to Czech -->
        <a 
          href="/" 
          class="font-mono text-xs px-2.5 py-1 rounded border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 hover:border-cyan-500 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-300 transition-all"
          title="Přepnout do češtiny"
        >
          CZ
        </a>

        <a 
          href={profile.links.cal} 
          target="_blank" 
          rel="noopener noreferrer"
          class="bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/30 px-3.5 py-1.5 rounded-lg font-medium hover:bg-cyan-500 hover:text-white dark:hover:text-slate-950 transition-all"
        >
          Book a Call
        </a>
      </nav>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-16 flex-1 space-y-24">
    <!-- Hero Section -->
    <section class="flex flex-col-reverse md:flex-row items-center justify-between gap-12 pt-4">
      <div class="flex-1 space-y-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-cyan-100 dark:bg-cyan-950/60 border border-cyan-300 dark:border-cyan-800 text-cyan-800 dark:text-cyan-300">
          IT Analyst & Solutions Architect
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Digitalization, Automation & <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-emerald-600 dark:from-cyan-400 dark:to-emerald-400">On-Premise AI</span>
        </h1>
        <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl">
          {profile.tagline.en}
        </p>
        <div class="flex flex-wrap items-center gap-4 pt-2">
          <!-- Primary CTA: Call -->
          <a 
            href={profile.links.cal} 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-cyan-500 to-emerald-500 text-slate-950 font-bold px-6 py-3.5 rounded-xl shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:opacity-95 active:scale-[0.98] transition-all"
          >
            <span>Schedule 15-min Tech Call</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <!-- Secondary CTA: PDF Brochure -->
          <a 
            href="/docs/projektova-brozura.pdf" 
            target="_blank"
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl font-semibold border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 shadow-sm hover:border-cyan-500 dark:hover:border-cyan-400 hover:bg-slate-50 dark:hover:bg-slate-800/90 hover:shadow-md hover:shadow-cyan-500/10 active:scale-[0.98] transition-all group"
          >
            <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400 transition-transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Download Project Brochure (PDF)</span>
          </a>
        </div>
      </div>
      <div class="relative group">
        <div class="absolute -inset-1 bg-gradient-to-r from-cyan-500 to-emerald-500 rounded-2xl blur-lg opacity-20 dark:opacity-30 group-hover:opacity-40 transition-all"></div>
        <img 
          src="/profile.jpg" 
          alt={profile.name} 
          class="relative w-56 h-56 sm:w-64 sm:h-64 object-cover rounded-2xl border border-slate-200 dark:border-slate-800 shadow-2xl"
        />
      </div>
    </section>


<!-- Section: Tech Stack & Certifications -->
    <section id="tech-stack" class="space-y-8">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Technology Stack & Certifications</h2>
          <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Production-proven tools, database architectures, and governance standards</p>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          ITIL5 Foundation Certified
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {profile.techStack.map((group) => (
          <div class="p-6 rounded-2xl border border-slate-300 dark:border-slate-700/90 bg-white dark:bg-slate-900/80 shadow-md hover:border-cyan-500 dark:hover:border-cyan-400/80 transition-all space-y-4">
            <h3 class="text-sm font-mono uppercase tracking-wider font-semibold text-cyan-600 dark:text-cyan-400">
              {group.category.en}
            </h3>
            <ul class="space-y-2.5">
              {group.items.map((item) => (
                <li class="flex items-center gap-2.5 text-sm text-slate-700 dark:text-slate-300">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 shrink-0"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

<!-- Section: Background & Leadership -->
    <section id="about" class="p-8 rounded-2xl border border-slate-300 dark:border-slate-700/90 bg-white dark:bg-slate-900/80 shadow-md space-y-6">
      <div class="space-y-1">
        <span class="text-xs font-mono font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">Senior Profile</span>
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Background & Leadership</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
        <div class="space-y-2">
          <div class="text-2xl font-mono font-bold text-cyan-600 dark:text-cyan-400">15+ Years</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide">Enterprise IT Experience</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Proven track record across mining, power utilities, and banking sectors. Strong focus on SLA stability, data integrity, and operational resilience.
          </p>
        </div>

        <div class="space-y-2">
          <div class="text-2xl font-mono font-bold text-emerald-600 dark:text-emerald-400">40+ Staff</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide">Team & Operations Lead</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Led multi-tier technical support and IT operations teams. Bridging complex executive business needs with hands-on developer execution.
          </p>
        </div>

        <div class="space-y-2">
          <div class="text-2xl font-mono font-bold text-purple-600 dark:text-purple-400">Architecture</div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white uppercase tracking-wide">Modern AI & Integration</h3>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Combining rigorous ITIL governance with rapid automation: on-premise RAG engines, event-driven n8n pipelines, and paperless architectures.
          </p>
        </div>
      </div>
    </section>

    <!-- Core Pillars -->
    <section id="expertise" class="space-y-8">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Areas of Expertise</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Bridging business strategy, operational processes, and modern tech</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {profile.pillars.map((pillar) => (
          <div class="p-6 rounded-xl border border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-900/40 hover:border-slate-300 dark:hover:border-slate-700 shadow-sm transition-all">
            <h3 class="text-lg font-semibold text-slate-900 dark:text-white mb-2">{pillar.title.en}</h3>
            <p class="text-sm text-slate-600 dark:text-slate-400 leading-relaxed">{pillar.desc.en}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Selected Projects & Case Studies -->
    <!-- Selected Projects & Case Studies -->
    <section id="projects" class="space-y-8">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Selected Case Studies</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Measurable impact and production-proven architectures (2021–2026)</p>
      </div>
      <div class="space-y-8">
        {projects.map((proj) => (
          <div class="p-6 sm:p-8 rounded-2xl border border-slate-300 dark:border-slate-700/90 bg-white dark:bg-slate-900/80 shadow-md hover:border-cyan-500 dark:hover:border-cyan-400/80 hover:shadow-xl hover:shadow-cyan-500/10 transition-all duration-200 space-y-6">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div class="space-y-1">
                <span class="text-xs font-mono font-semibold text-cyan-600 dark:text-cyan-400">{proj.date}</span>
                <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight">{proj.title.en}</h3>
              </div>
              <div class="flex flex-wrap gap-1.5">
                {proj.tags.map((tag) => (
                  <span class="px-2.5 py-1 rounded text-xs font-mono bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-200 border border-slate-200 dark:border-slate-700 shadow-xs">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <p class="text-slate-600 dark:text-slate-300 text-sm leading-relaxed">
              {proj.context.en}
            </p>

            {proj.flow && (
              <div class="p-4 sm:p-5 rounded-xl bg-slate-50 dark:bg-slate-950/90 border border-slate-200 dark:border-slate-700/80 shadow-inner">
                <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mb-2.5 uppercase tracking-wider font-semibold">Data Architecture Flow</div>
                <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
                  {proj.flow.map((node, i) => (
                    <>
                      <span class="px-2.5 py-1 rounded bg-white dark:bg-slate-900 text-cyan-700 dark:text-cyan-300 border border-slate-200 dark:border-slate-700 shadow-xs font-medium">
                        {node}
                      </span>
                      {i < proj.flow.length - 1 && <span class="text-slate-400 dark:text-slate-500 font-bold">➔</span>}
                    </>
                  ))}
                </div>
              </div>
            )}

            <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/30 border border-emerald-200 dark:border-emerald-700/60 text-emerald-900 dark:text-emerald-300 text-sm flex items-start gap-3">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold text-base">✓</span>
              <span><strong>Result:</strong> {proj.metrics.en}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

<!-- Contact Section -->
    <section id="contact" class="space-y-8">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
        <h2 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Get in Touch</h2>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">Planning a digitalization project, on-premise AI setup, or hands-on team enablement?</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Email card with copy -->
        <div class="p-6 sm:p-8 rounded-2xl border border-slate-300 dark:border-slate-700/90 bg-white dark:bg-slate-900/80 shadow-md flex flex-col justify-between space-y-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-mono font-semibold text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              Direct Channel
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Send me an email</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              I typically reply within 24 hours. Open to discussing technical scoping, architecture, or training workshops.
            </p>
          </div>

          <div class="space-y-3 pt-2">
            <div class="flex flex-wrap items-center gap-3">
              <a 
                href={`mailto:${profile.links.email}`} 
                class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-cyan-500/10 dark:hover:bg-cyan-500/10 text-slate-900 dark:text-white border border-slate-300 dark:border-slate-700 hover:border-cyan-500 font-mono text-sm font-semibold transition-all"
              >
                <span>{profile.links.email}</span>
                <svg class="w-4 h-4 text-cyan-600 dark:text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <button
                type="button"
                id="copy-email-btn-en"
                data-email={profile.links.email}
                class="px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:text-cyan-600 dark:hover:text-cyan-300 hover:border-cyan-500 text-xs font-mono transition-all flex items-center gap-2"
                title="Copy to clipboard"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copy-email-text-en">Copy</span>
              </button>
            </div>
            <div class="text-xs text-slate-500 dark:text-slate-400 font-mono flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Location: {profile.location.en}
            </div>
          </div>
        </div>

        <!-- Cal.com Booking Card -->
        <div class="p-6 sm:p-8 rounded-2xl border border-slate-300 dark:border-slate-700/90 bg-white dark:bg-slate-900/80 shadow-md flex flex-col justify-between space-y-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-mono font-semibold text-emerald-600 dark:text-emerald-400 uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              15-Min Intro Call
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white">Pick a slot in my calendar</h3>
            <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Prefer a direct conversation? Choose an open time slot that fits your schedule and let's discuss details.
            </p>
          </div>

          <div class="pt-2">
            <a 
              href={profile.links.cal} 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-cyan-500 to-emerald-500 text-slate-950 font-bold px-6 py-3.5 rounded-xl shadow-lg shadow-cyan-500/20 hover:opacity-95 transition-all text-sm"
            >
              <span>Open Scheduling Calendar</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-950 mt-16 py-8">
    <div class="max-w-6xl mx-auto px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div>© {new Date().getFullYear()} {profile.name}. Powered by Astro & Cloudflare.</div>
      <div class="flex items-center gap-6">
        <a href={profile.links.github} target="_blank" class="hover:text-cyan-600 dark:hover:text-cyan-400">GitHub</a>
        <a href={profile.links.linkedin} target="_blank" class="hover:text-cyan-600 dark:hover:text-cyan-400">LinkedIn</a>
        <a href={profile.links.cal} target="_blank" class="hover:text-cyan-600 dark:hover:text-cyan-400">Cal.com</a>
      </div>
    </div>
  </footer>
</Layout>

<script is:inline>
  const copyBtnEn = document.getElementById('copy-email-btn-en');
  const copyTextEn = document.getElementById('copy-email-text-en');
  if (copyBtnEn && copyTextEn) {
    copyBtnEn.addEventListener('click', async () => {
      const email = copyBtnEn.getAttribute('data-email');
      if (email) {
        await navigator.clipboard.writeText(email);
        copyTextEn.textContent = 'Copied!';
        setTimeout(() => {
          copyTextEn.textContent = 'Copy';
        }, 2000);
      }
    });
  }
</script>